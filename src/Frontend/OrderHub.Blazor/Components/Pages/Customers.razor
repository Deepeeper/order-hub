@page "/customers"
@rendermode InteractiveServer
@inject CustomerApiClient CustomerApi

<PageTitle>Customers</PageTitle>

<header class="oh-page-header">
    <h1>Customers</h1>
    <p class="oh-lede">Existing customers.</p>
</header>

@if (_loading)
{
    <p>Loading...</p>
}
else
{
    <table class="oh-table">
        <thead>
            <tr><th>Name</th><th>Country</th><th>Contact</th><th>Active</th></tr>
        </thead>
        <tbody>
            @foreach (var c in _customers)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.Country</td>
                    <td>@c.ContactEmail</td>
                    <td>@(c.IsActive ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    bool _loading = true;
    List<CustomerDto> _customers = new();

    protected override async Task OnInitializedAsync()
    {
        try { _customers = await CustomerApi.GetCustomersAsync(); }
        finally { _loading = false; }
    }
}
