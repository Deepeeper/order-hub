@page "/orders/new"
@rendermode InteractiveServer
@inject OrderApiClient OrderApi
@inject CustomerApiClient CustomerApi
@inject ProductApiClient ProductApi
@inject NavigationManager Nav

<PageTitle>New order</PageTitle>

<header class="oh-page-header">
    <h1>New order</h1>
    <p class="oh-lede">Place an order against an existing customer.</p>
</header>

@if (_loading)
{
    <p>Loading customers and products...</p>
}
else
{
    <div class="oh-form">
        <label>
            Customer:
            <select @bind="_customerId">
                <option value="0">— select customer —</option>
                @foreach (var c in _customers)
                {
                    <option value="@c.Id">@c.Name (@c.Country)</option>
                }
            </select>
        </label>

        <label>
            Due date:
            <input type="date" @bind="_dueDate" />
        </label>

        <label>
            Notes:
            <input type="text" @bind="_notes" placeholder="Optional" />
        </label>

        <h2>Lines</h2>
        @for (int i = 0; i < _lines.Count; i++)
        {
            var idx = i;
            <div class="oh-line-row">
                <select @bind="_lines[idx].ProductId">
                    <option value="0">— select product —</option>
                    @foreach (var p in _products)
                    {
                        <option value="@p.Id">@p.Name (@p.SteelGrade)</option>
                    }
                </select>
                <input type="number" min="0" step="1" @bind="_lines[idx].Quantity" placeholder="Quantity (kg)" />
                <button class="oh-btn oh-btn-secondary" @onclick="() => RemoveLine(idx)">−</button>
            </div>
        }
        <button class="oh-btn oh-btn-secondary" @onclick="AddLine">+ Add line</button>

        <div class="oh-toolbar">
            <button class="oh-btn oh-btn-primary" @onclick="SubmitAsync">Create order</button>
            <a class="oh-btn" href="orders">Cancel</a>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="oh-error">@_error</p>
        }
    </div>
}

@code {
    bool _loading = true;
    List<CustomerDto> _customers = new();
    List<ProductDto> _products = new();

    int _customerId = 0;
    DateTime? _dueDate = DateTime.Today.AddDays(30);
    string? _notes;
    List<LineModel> _lines = new() { new() };
    string? _error;

    class LineModel
    {
        public int ProductId { get; set; }
        public decimal Quantity { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _customers = await CustomerApi.GetCustomersAsync();
            _products = await ProductApi.GetProductsAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    void AddLine() => _lines.Add(new());
    void RemoveLine(int i) { if (_lines.Count > 1) _lines.RemoveAt(i); }

    async Task SubmitAsync()
    {
        _error = null;

        if (_customerId <= 0)
        {
            _error = "Please select a customer.";
            return;
        }
        var validLines = _lines.Where(l => l.ProductId > 0 && l.Quantity > 0).ToList();
        if (validLines.Count == 0)
        {
            _error = "Add at least one line with a product and a positive quantity.";
            return;
        }

        try
        {
            var request = new CreateOrderRequest(
                _customerId,
                _dueDate,
                _notes,
                validLines.Select(l => new CreateOrderLineRequest(l.ProductId, l.Quantity)).ToList());

            var id = await OrderApi.CreateOrderAsync(request);
            if (id.HasValue)
            {
                Nav.NavigateTo($"orders/{id.Value}");
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not create order: {ex.Message}";
        }
    }
}
