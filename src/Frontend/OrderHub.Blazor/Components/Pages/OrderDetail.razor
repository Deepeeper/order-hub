@page "/orders/{Id:int}"
@rendermode InteractiveServer
@inject OrderApiClient OrderApi
@inject NavigationManager Nav

<PageTitle>Order @(_order?.OrderNumber ?? "")</PageTitle>

@if (_loading)
{
    <p>Loading...</p>
}
else if (_order is null)
{
    <p>Order not found.</p>
}
else
{
    <header class="oh-page-header">
        <h1>@_order.OrderNumber</h1>
        <p class="oh-lede">@_order.CustomerName</p>
    </header>

    <section class="oh-meta">
        <div><strong>Status:</strong> <span class="oh-badge oh-badge-@_order.Status.ToString().ToLower()">@_order.Status</span></div>
        <div><strong>Created:</strong> @_order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
        <div><strong>Due date:</strong> @(_order.DueDate?.ToString("yyyy-MM-dd") ?? "–")</div>
        @if (!string.IsNullOrEmpty(_order.Notes))
        {
            <div><strong>Notes:</strong> @_order.Notes</div>
        }
    </section>

    <section>
        <h2>Lines</h2>
        <table class="oh-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Steel grade</th>
                    <th class="oh-right">Quantity (kg)</th>
                    <th class="oh-right">Unit price</th>
                    <th class="oh-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in _order.Lines)
                {
                    <tr>
                        <td>@l.ProductName</td>
                        <td>@l.SteelGrade</td>
                        <td class="oh-right">@l.Quantity.ToString("N0")</td>
                        <td class="oh-right">@l.UnitPrice.ToString("N2")</td>
                        @* KNOWN GAP: business logic (line amount) is computed here in the view
                           instead of in the domain or the backend service. *@
                        <td class="oh-right">@((l.Quantity * l.UnitPrice).ToString("N2"))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="oh-right"><strong>Total:</strong></td>
                    @* KNOWN GAP: the total is computed here in the view instead of in the backend. *@
                    <td class="oh-right"><strong>@_order.Lines.Sum(l => l.Quantity * l.UnitPrice).ToString("N2")</strong></td>
                </tr>
            </tfoot>
        </table>
    </section>

    <section class="oh-toolbar">
        <label>
            Change status:
            <select @bind="_newStatus">
                <option value="Pending">Pending</option>
                <option value="InProduction">In production</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </label>
        <button class="oh-btn oh-btn-primary" @onclick="UpdateStatusAsync">Save status</button>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    bool _loading = true;
    OrderDetailDto? _order;
    string _newStatus = "Pending";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _order = await OrderApi.GetOrderAsync(Id);
            if (_order is not null) _newStatus = _order.Status.ToString();
        }
        finally
        {
            _loading = false;
        }
    }

    async Task UpdateStatusAsync()
    {
        if (_order is null) return;
        await OrderApi.UpdateStatusAsync(_order.Id, Enum.Parse<OrderStatus>(_newStatus));
        _order = await OrderApi.GetOrderAsync(Id);
    }
}
