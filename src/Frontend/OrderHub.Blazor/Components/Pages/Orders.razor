@page "/orders"
@rendermode InteractiveServer
@inject OrderApiClient OrderApi
@inject NavigationManager Nav

<PageTitle>Orders</PageTitle>

<header class="oh-page-header">
    <h1>Orders</h1>
    <p class="oh-lede">Filter, review and set status.</p>
</header>

<section class="oh-toolbar">
    <label>
        Status:
        <select @bind="_filter" @bind:after="ReloadAsync">
            <option value="">All</option>
            <option value="Pending">Pending</option>
            <option value="InProduction">In production</option>
            <option value="Completed">Completed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </label>
    <a class="oh-btn oh-btn-primary" href="orders/new">New order</a>
</section>

@if (_loading)
{
    <p>Loading...</p>
}
else if (!_orders.Any())
{
    <p class="oh-empty">No orders match the filter.</p>
}
else
{
    <table class="oh-table">
        <thead>
            <tr>
                <th>Order</th>
                <th>Customer</th>
                <th>Status</th>
                <th>Created</th>
                <th>Due date</th>
                <th>Lines</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in _orders)
            {
                <tr>
                    <td><a href="orders/@o.Id">@o.OrderNumber</a></td>
                    <td>@o.CustomerName</td>
                    <td><span class="oh-badge oh-badge-@o.Status.ToString().ToLower()">@o.Status</span></td>
                    <td>@o.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>@(o.DueDate?.ToString("yyyy-MM-dd") ?? "–")</td>
                    <td>@o.LineCount</td>
                    <td>
                        <button class="oh-btn oh-btn-danger" @onclick="() => DeleteAsync(o.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(_message))
{
    <div class="oh-toast">@_message</div>
}

@code {
    bool _loading = true;
    string _filter = "";
    List<OrderSummaryDto> _orders = new();
    string? _message;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            OrderStatus? status = string.IsNullOrEmpty(_filter)
                ? null
                : Enum.Parse<OrderStatus>(_filter);
            _orders = await OrderApi.GetOrdersAsync(status);
        }
        finally
        {
            _loading = false;
        }
    }

    // KNOWN GAP: the Delete button in the UI calls an endpoint that doesn't exist on the API.
    // This method does nothing useful — fixing it is one of the lab tasks.
    async Task DeleteAsync(int id)
    {
        try
        {
            // TODO: the API has no DELETE endpoint. The button shipped too early.
            await Task.Delay(100); // placeholder
            _message = $"Order {id} could not be deleted (endpoint missing).";
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
        }
    }
}
