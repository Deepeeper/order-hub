@inherits LayoutComponentBase

<div class="oh-shell">
    <aside>
        <NavMenu />
    </aside>
    <main>
        <div class="oh-topbar">
            <div class="oh-search">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                <input placeholder="Sök ordernummer, kund..." />
            </div>
            <div class="oh-topbar-meta">
                <span class="oh-env-badge">Development</span>
                <span class="oh-divider"></span>
                <span class="oh-link">Hjälp</span>
            </div>
        </div>
        <div class="oh-content">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <span>Ett oväntat fel inträffade.</span>
    <a href="." class="reload">Ladda om</a>
    <span class="dismiss">✕</span>
</div>
